# Dependencies
node_modules/
.pnpm-store/
.npm/
.yarn/

# Lockfiles for wrong package managers (we use pnpm exclusively per docs/stack.md)
package-lock.json
yarn.lock
bun.lockb

# Build outputs
dist/
dist-ssr/
build/
*.local
*.tsbuildinfo

# Tool caches
.vite/
.vitest-cache/
.eslintcache
.turbo/

# Documentations
.rabit-memory/*

# Branding / logo assets — not source code, regenerate from design files
src/assets/branding/
docs/brand/

# Generated Tauri icon source (the derived platform icons in src-tauri/icons/ are tracked)
src-tauri/icons/source.png

# Claude Code tool settings (personal / machine-specific)
.claude/

# Editor directories and files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.fleet/
.zed/
.history/
*.iml
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS-specific artifacts
.DS_Store
._*
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage
coverage/
*.lcov
.nyc_output/
playwright-report/
blob-report/
test-results/

# Environment
.env
.env.local
.env.*.local

# Rust / Tauri
# Note: src-tauri/Cargo.lock IS tracked — RaBIT is a binary/application, and
# Cargo convention is to commit the lockfile for reproducible builds.
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
*.rs.bk

# Platform installer outputs
*.exe
*.msi
*.dmg
*.deb
*.AppImage

# Backup files
*.bak
*.orig
